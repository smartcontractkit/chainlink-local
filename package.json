{
  "name": "@chainlink/local",
  "description": "Chainlink Local Simulator",
  "license": "MIT",
  "version": "0.3.1",
  "type": "module",
  "exports": {
    "./svm": {
      "types": "./dist/svm/index.d.ts",
      "import": "./dist/svm/index.js"
    },
    "./*": "./*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.sol",
    "!src/test/**/*",
    "scripts/CCIPLocalSimulatorFork.js",
    "scripts/CCIPLocalSimulatorFork.d.ts",
    "scripts/data-streams/**/*.js",
    "dist/svm/**",
    "remappings.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcontractkit/chainlink-local.git"
  },
  "keywords": [
    "chainlink"
  ],
  "scripts": {
    "hardhat-compile": "npx hardhat compile",
    "forge-compile": "forge build",
    "hardhat-test": "npx hardhat test",
    "hardhat-test-js": "node --test --test-concurrency=1 --test-timeout=600000 test/smoke/data-streams/*.test.js test/e2e/ccip/*.test.js",
    "js-unit-test": "npx hardhat build --no-tests --quiet && node --test test/unit/**/*.unit.test.js",
    "forge-test": "forge test",
    "test": "npm run hardhat-test && npm run js-unit-test && npm run forge-test",
    "prettier": "prettier --write 'api_reference/**/*'",
    "generate-solidity": "node helper_doc/generate-solidity-docs.mjs",
    "generate-jsdoc": "node helper_doc/generate-jsdoc.mjs",
    "generate-index": "node helper_doc/generate-index-files.mjs",
    "generate-docs": "npm run generate-solidity && npm run generate-jsdoc && npm run generate-index && npm run prettier",
    "update-register": "node helper_doc/updateRegisterContract.cjs",
    "build:svm": "tsc -p tsconfig.svm.json",
    "prepack": "npm run build:svm && cp remappings.txt .remappings.txt.dev-backup && cp remappings-npm.txt remappings.txt",
    "postpack": "mv .remappings.txt.dev-backup remappings.txt"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@chainlink/ace": "^1.0.0",
    "@nomicfoundation/hardhat-ethers": "4.0.5",
    "@solana/surfpool": "1.7.0",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.20.5",
    "dotenv": "^16.4.5",
    "ethers": "6.17.0",
    "hardhat": "^3.1.10",
    "jsdoc-to-markdown": "^8.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@chainlink/contracts-ccip": "2.0.0",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@4.8.3",
    "@openzeppelin/contracts-5.3.0": "npm:@openzeppelin/contracts@5.3.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4"
  },
  "peerDependencies": {
    "@anchor-lang/core": "^1.2",
    "@nomicfoundation/hardhat-ethers": "^4.0.5",
    "@solana/surfpool": "1.7.0",
    "@solana/web3.js": "^1.98",
    "ethers": "^6.17.0",
    "hardhat": "^3.1.10"
  },
  "peerDependenciesMeta": {
    "@anchor-lang/core": {
      "optional": true
    },
    "@solana/surfpool": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "hardhat": {
      "optional": true
    },
    "@nomicfoundation/hardhat-ethers": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  }
}
