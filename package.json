{
  "name": "@chainlink/local",
  "description": "Chainlink Local Simulator",
  "license": "MIT",
  "version": "0.3.0-beta.0",
  "type": "module",
  "files": [
    "src/**/*.sol",
    "!src/test/**/*",
    "scripts/CCIPLocalSimulatorFork.js",
    "scripts/data-streams/**/*.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcontractkit/chainlink-local.git"
  },
  "keywords": [
    "chainlink"
  ],
  "scripts": {
    "hardhat-compile": "npx hardhat compile",
    "forge-compile": "forge build",
    "hardhat-test": "npx hardhat test",
    "hardhat-test-js": "node --test --test-concurrency=1 --test-timeout=600000 test/smoke/data-streams/*.test.js test/e2e/ccip/*.test.js",
    "forge-test": "forge test",
    "test": "npm run hardhat-test && npm run forge-test",
    "prettier": "prettier --write 'api_reference/**/*'",
    "generate-solidity": "node helper_doc/generate-solidity-docs.mjs",
    "generate-jsdoc": "node helper_doc/generate-jsdoc.mjs",
    "generate-index": "node helper_doc/generate-index-files.mjs",
    "generate-docs": "npm run generate-solidity && npm run generate-jsdoc && npm run generate-index && npm run prettier",
    "update-register": "node helper_doc/updateRegisterContract.cjs"
  },
  "devDependencies": {
    "@chainlink/ace": "^1.0.0",
    "@nomicfoundation/hardhat-ethers": "4.0.5",
    "@openzeppelin/contracts-4.8.3": "npm:@openzeppelin/contracts@4.8.3",
    "@openzeppelin/contracts-5.3.0": "npm:@openzeppelin/contracts@5.3.0",
    "dotenv": "^16.4.5",
    "ethers": "6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.1.10",
    "jsdoc-to-markdown": "^8.0.1",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@chainlink/contracts-ccip": "2.0.0"
  }
}
